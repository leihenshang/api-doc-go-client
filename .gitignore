# 依赖与构建产物
node_modules/
frontend/dist/
build/bin/
# wails build -nsis 自动写入的 WebView2 引导器（~2MB，每次构建重新生成，不入库）
build/windows/installer/tmp/
# wails build -nsis 生成的 NSIS 工程与宏库（每次 bootstrap 自动重写，不入库；安装包逻辑以手写的 installer.nsi 为权威）
build/windows/installer/project.nsi
build/windows/installer/wails_tools.nsh

# 本地数据
*.local.yml
# 同步绑定（PAT 本地加密后落盘的密文，0600）与冲突副本：随集合目录出现，不入库/不外传
.sync.json
.conflicts/

# 临时产物（测试集合/配置/截图等）
.tmp/
frontend/package.json.md5

# ===== 本地多模块联调（父目录 go.work，不入库）=====
go.work
go.work.sum

# 内部设计与审计文档（不随仓库发布）
.doc

# AI 工具目录（本机 skill / 会话记忆等）
.codebuddy
.workbuddy/
